# Copy to .env and fill in. Never commit .env.

# --- Paths ---
# Folder with the applications (mounted read-only)
STC_ROOT=/path/to/applications
# More folders with applications (see docs/getting-started.md, "More than one folder").
# Default: ./sources.toml when it exists.
# STC_SOURCES=./sources.toml
STC_CATALOGS=./catalogs
STC_DATA=./data

# --- Database ---
POSTGRES_PASSWORD=change-me
STC_APP_PASSWORD=change-me
STC_DB_URL=postgresql://stc_app:change-me@localhost:5432/stc
STC_DB_MIGRATION_URL=postgresql://postgres:change-me@localhost:5432/stc

# --- LLM ---
# Provider: openai (default) or anthropic
STC_LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional: Azure or any OpenAI-compatible gateway
# STC_OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
STC_LLM_CATALOG_MODEL=
STC_LLM_CHAT_MODEL=
# Reasoning models (e.g. the GPT-5/6 family) reject tool calls unless this is "none":
# STC_LLM_CHAT_REASONING_EFFORT=none
# STC_LLM_CATALOG_REASONING_EFFORT=

# --- Embeddings and reranking ---
# Provider: openai (default), voyage or local
STC_EMBEDDINGS_PROVIDER=openai
STC_EMBEDDINGS_MODEL=
# Must be 1536 (the vector columns); text-embedding-3-* models can be asked for it
STC_EMBEDDINGS_DIMENSIONS=1536
# VOYAGE_API_KEY=
# Empty = no reranking
STC_RERANK_MODEL=

# --- Output language, throughput ---
STC_LANGUAGE=en
STC_CONCURRENCY=4
STC_LLM_REQUESTS_PER_MIN=60

# --- MCP (HTTP transport) ---
STC_MCP_TOKEN=
# STC_MCP_HOST=127.0.0.1
# STC_MCP_PORT=8765

# --- Runtime ---
STC_ENVIRONMENT=development
STC_PUBLIC_URL=http://localhost:8000

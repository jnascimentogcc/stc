{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stc.example/contracts/interface-mapping.schema.json",
  "title": "STC interface mapping",
  "description": "What corresponds to what between the legacy interface and the migrated one, for one program. Written as YAML in the client's test repository (mapping/<application>/<program>.mapping.yaml), drafted by the AI and approved by the migration team. Major version 1: a reader refuses another major version; unknown properties are allowed (minor versions add them).",
  "type": "object",
  "required": ["schema", "application", "program", "status", "legacy", "target", "compare", "accepted_differences", "open_questions"],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^stc\\.interface-mapping/1(\\.[0-9]+)?$"
    },
    "application": { "type": "string", "minLength": 1 },
    "program": {
      "description": "The feature slug of the specification this mapping belongs to.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "status": { "enum": ["draft", "approved"] },
    "approved_by": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "proposed_by": {
      "description": "Provenance of the draft.",
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string" },
        "prompt_version": { "type": "string" }
      }
    },
    "spec_code_version": {
      "description": "The code version of the specification the draft was written from.",
      "type": "string"
    },
    "legacy": {
      "type": "object",
      "required": ["kind", "executable", "inputs"],
      "if": { "properties": { "executable": { "const": true } }, "required": ["executable"] },
      "then": { "required": ["request"] },
      "properties": {
        "kind": { "enum": ["console", "http", "batch", "args"] },
        "executable": {
          "description": "Whether the tests may run the legacy. Always false for COBOL, which is never executed.",
          "type": "boolean"
        },
        "request": {
          "description": "How an executable legacy is called over HTTP, in the same terms as `target`: the tests run the same scenarios against it as an oracle. Required when `executable` is true (schema 1.1).",
          "type": "object",
          "required": ["method", "path", "fields", "results"],
          "properties": {
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string", "pattern": "^/" },
            "fields": {
              "description": "Logical input name -> property of the JSON request body.",
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "results": {
              "description": "Logical result name -> JSON path in the response.",
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inputs": {
          "description": "How the legacy is fed, in order. `name` is the logical field the target mapping refers to.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
              "prompt": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["kind", "request", "fields", "results"],
      "properties": {
        "kind": { "const": "http" },
        "request": {
          "type": "object",
          "required": ["method", "path"],
          "properties": {
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string", "pattern": "^/" }
          }
        },
        "fields": {
          "description": "Logical input name -> property of the JSON request body.",
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "results": {
          "description": "Logical result name -> JSON path in the response.",
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compare": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["structured", "transcript"] },
        "normalization": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule"],
            "properties": {
              "rule": { "type": "string", "minLength": 1 },
              "applies_to": { "type": "string" }
            }
          }
        }
      }
    },
    "accepted_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "justification", "decided_by"],
        "properties": {
          "id": { "type": "string", "pattern": "^AD-[0-9]{2,}$" },
          "description": { "type": "string", "minLength": 1 },
          "justification": { "type": "string", "minLength": 1 },
          "decided_by": { "type": "string", "minLength": 1 },
          "covers": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[A-Z]{2}-[0-9]{2,}$" }
          }
        }
      }
    },
    "open_questions": {
      "description": "What the draft could not decide. An approved mapping has none.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
  "then": {
    "required": ["approved_by", "approved_at"],
    "properties": { "open_questions": { "maxItems": 0 } }
  }
}

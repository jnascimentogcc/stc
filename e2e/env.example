# Copy to .env.e2e (git-ignored) at the repository root. Used only by docker-compose.e2e.yml.
POSTGRES_PASSWORD=change-me-e2e
STC_APP_PASSWORD=change-me-e2e-app
STC_MCP_TOKEN=change-me-e2e-token
STC_ROOT=./e2e/root

STC_API_PORT=8100
STC_WEB_PORT=8180
STC_MCP_PORT=8865

# Needed only for the steps that call a model (catalog, docs, spec, chat, embeddings).
STC_LLM_PROVIDER=openai
OPENAI_API_KEY=
STC_LLM_CATALOG_MODEL=
STC_LLM_CHAT_MODEL=
STC_EMBEDDINGS_PROVIDER=openai
STC_EMBEDDINGS_MODEL=text-embedding-3-small
STC_EMBEDDINGS_DIMENSIONS=1536
STC_LANGUAGE=en

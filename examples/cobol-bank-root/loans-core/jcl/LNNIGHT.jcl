//LNNIGHT  JOB (BANK),'LOANS NIGHTLY',CLASS=A,MSGCLASS=X
//*--------------------------------------------------------------------
//* LATE INSTALLMENTS: CHARGES, DEFAULTS, DAILY REPORT
//*--------------------------------------------------------------------
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=DSNB10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//LATERPT  DD DSN=BANK.LOANS.LATE.DAILY,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=59)
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(LNBATCH) PLAN(LNPLAN) LIB('BANK.LOANS.LOADLIB')
  END
/*
//STEP020  EXEC PGM=SORT,COND=(0,NE)
//SORTIN   DD DSN=BANK.LOANS.LATE.DAILY,DISP=SHR
//SORTOUT  DD DSN=BANK.LOANS.LATE.SORTED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=59)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(14,5,ZD,D)
/*

TLRSET   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,CTRL=FREEKB
TLRQRY   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,28),LENGTH=21,ATTRB=ASKIP,INITIAL='BALANCE ENQUIRY'
         DFHMDF POS=(4,5),LENGTH=8,ATTRB=ASKIP,INITIAL='Account:'
ACCT     DFHMDF POS=(4,15),LENGTH=10,ATTRB=(UNPROT,NUM),PICIN='9(10)'
         DFHMDF POS=(6,5),LENGTH=8,ATTRB=ASKIP,INITIAL='Balance:'
BAL      DFHMDF POS=(6,15),LENGTH=14,ATTRB=ASKIP,PICOUT='-Z(9)9.99'
MSG      DFHMDF POS=(9,5),LENGTH=40,ATTRB=ASKIP
         DFHMSD TYPE=FINAL
         END
